# ---------------------------------------------------------------------------
# .htaccess para DonWeb cPanel (Ferozo) — App de boda + API PHP
# Subir junto al contenido de dist/ en public_html, junto a api.php
# ---------------------------------------------------------------------------

RewriteEngine On

# 1) Las llamadas a /api/* se resuelven contra api.php conservando la sub-ruta.
#    La regla es relativa al directorio de instalación, también en subcarpetas.
RewriteRule ^api/(.*)$ api.php/$1 [QSA,L]

# 2) La carpeta de datos y sus archivos temporales nunca se sirven por HTTP.
RewriteRule ^data(?:/|$) - [F,NC,L]

# 3) SPA: cualquier otra ruta que no sea archivo/carpeta real sirve index.html
#    (para que /rsvp/MARISIMON y /admin funcionen con recarga directa)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.html [L]

# No publicar bundles de servidor ni source maps si se sube todo dist/.
<FilesMatch "\.(cjs|map)$">
  Require all denied
</FilesMatch>

# MIME types de video: algunos cPanel viejos no sirven .webm con el type correcto
# y Safari/iOS rechaza la reproduccion si llega como application/octet-stream.
AddType video/webm .webm
AddType video/mp4 .mp4
